{
  "name": "real-estate-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MERN Real Estate Management System monorepo",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev:backend": "npm --workspace backend run dev",
    "start:backend": "npm --workspace backend start",
    "seed": "npm --workspace backend run seed"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
